{
  "name": "print-service",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "type-check": "tsc --noEmit",
    "sonar": "sonar-scanner",
    "sonar:test": "tsx scripts/test-connection.ts",
    "sonar:fetch": "tsx scripts/fetch-issues.ts",
    "sonar:fix": "tsx scripts/fix-issues.ts",
    "sonar:fix:high": "tsx scripts/fix-issues.ts -- --group=HIGH",
    "sonar:fix:medium": "tsx scripts/fix-issues.ts -- --group=MEDIUM",
    "sonar:fix:low": "tsx scripts/fix-issues.ts -- --group=LOW"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^3.3.4",
    "@tanstack/react-query": "^5.56.0",
    "@tanstack/react-query-devtools": "^5.56.0",
    "axios": "^1.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "gsap": "^3.13.0",
    "i18n-iso-countries": "^7.14.0",
    "motion": "^12.23.25",
    "next": "^14.2.0",
    "next-intl": "^3.15.0",
    "ogl": "^1.0.11",
    "pdfjs-dist": "^5.4.449",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-google-recaptcha": "^3.1.0",
    "react-hook-form": "^7.52.0",
    "react-intersection-observer": "^9.13.0",
    "recharts": "^3.5.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.4.0",
    "three": "^0.181.2",
    "zod": "^3.23.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-google-recaptcha": "^2.1.9",
    "@types/three": "^0.181.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "autoprefixer": "^10.4.0",
    "dotenv": "^17.2.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "postcss": "^8.4.0",
    "prettier": "^3.3.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.7.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
