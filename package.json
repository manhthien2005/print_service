    "date-fns": "^3.6.0",
    "zustand": "^4.5.0",
    "react-hook-form": "^7.52.0",
    "zod": "^3.23.0",
    "@hookform/resolvers": "^3.3.4",
    "axios": "^1.7.0",
    "react-intersection-observer": "^9.13.0",
